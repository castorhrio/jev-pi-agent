{
  "name": "ucad",
  "version": "0.1.0",
  "private": true,
  "description": "UCAD — Unified Coding Agent Desktop (Local-first multi-agent coding workbench)",
  "license": "MIT",
  "author": "Xyris",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "apps/desktop/dist/main/bootstrap.js",
  "scripts": {
    "build:packages": "tsc --build tsconfig.build.json",
    "build:desktop": "npm run build:main -w @ucad/desktop && npm run build:preload -w @ucad/desktop && npm run build:renderer -w @ucad/desktop",
    "build": "npm run build:packages && npm run build:desktop",
    "clean": "tsc --build tsconfig.build.json --clean",
    "typecheck": "tsc --build tsconfig.build.json && tsc --build apps/desktop/tsconfig.main.json && tsc --project apps/desktop/tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "dev:web": "vite --config apps/desktop/vite.config.ts",
    "pretest": "npm run build:packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dev": "npm run build && electron .",
    "start": "npm run dev",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "dev.ucad.desktop",
    "productName": "UCAD",
    "directories": {
      "output": "release",
      "buildResources": "apps/desktop/resources"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "packages/*/dist/**/*",
      "packages/*/package.json",
      "!**/*.map",
      "!**/node_modules/**/test/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "happy-dom": "^20.14.5",
    "knip": "6.39.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.15"
  }
}
